---
import { site } from '../config/site';
---

<!-- 스크롤에 따라 문장이 잉크처럼 번져 진해집니다 (scrub). -->
<section class="bg-paper py-28 md:py-44" aria-label={`${site.brandKo} 소개`}>
  <div class="wrap">
    <p class="max-w-[21em] text-statement font-semibold" data-fill>
      {site.brandKo}는 대화를 기억하는 AI 컴패니언을 만듭니다. 어제 나눈 이야기를 오늘 이어가고, 지나가듯 한 말도 잊지 않는
      대화 상대. 누군가의 하루 끝에 가장 먼저 떠오르는 이름이 되는 것이 우리가 하는 일입니다.
    </p>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';

  const el = document.querySelector<HTMLElement>('[data-fill]');

  if (el && !prefersReducedMotion) {
    const words = (el.textContent ?? '').trim().split(/\s+/);
    el.replaceChildren(
      ...words.flatMap((w, i) => {
        const span = document.createElement('span');
        span.className = 'inline-block';
        span.textContent = w;
        return i ? [' ', span] : [span];
      }),
    );

    gsap.fromTo(
      el.children,
      { opacity: 0.16 },
      {
        opacity: 1,
        ease: 'none',
        stagger: 0.1,
        scrollTrigger: { trigger: el, start: 'top 80%', end: 'bottom 55%', scrub: 0.6 },
      },
    );
  }
</script>
