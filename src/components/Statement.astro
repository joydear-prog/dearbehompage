---
import { getLang, t } from '../i18n';

const { statement } = t(getLang(Astro.url));
---

<!-- 스크롤에 따라 문장이 잉크처럼 번져 진해집니다 (scrub). -->
<section class="bg-paper py-28 md:py-44" aria-label={statement.label}>
  <div class="wrap">
    <p class="max-w-[21em] text-statement font-semibold" data-fill>{statement.text}</p>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';

  const el = document.querySelector<HTMLElement>('[data-fill]');

  if (el && !prefersReducedMotion) {
    const words = (el.textContent ?? '').trim().split(/\s+/);
    el.replaceChildren(
      ...words.flatMap((w, i) => {
        const span = document.createElement('span');
        span.className = 'inline-block';
        span.textContent = w;
        return i ? [' ', span] : [span];
      }),
    );

    gsap.fromTo(
      el.children,
      { opacity: 0.16 },
      {
        opacity: 1,
        ease: 'none',
        stagger: 0.1,
        scrollTrigger: { trigger: el, start: 'top 80%', end: 'bottom 55%', scrub: 0.6 },
      },
    );
  }
</script>
