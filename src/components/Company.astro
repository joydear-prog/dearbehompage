---
import { site } from '../config/site';
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const { company } = t(lang);

// 애플 확인 담당자가 사이트에서 회사 정보를 찾을 수 있도록 본문에도 노출합니다. 빈 값은 표시하지 않습니다.
const rows = company.rows.filter(([, value]) => value);
---

<section id="company" class="bg-paper py-28 md:py-40">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <h2 class="max-w-[9em] text-headline font-bold">{company.heading}</h2>
      <p class="mt-6 max-w-[28rem] text-graphite">{company.story}</p>
    </div>

    <dl class="lg:col-span-6 lg:col-start-7">
      {
        rows.map(([label, value]) => (
          <div class="grid gap-1 border-b border-rule py-5 first:pt-0 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="text-[0.9375rem] text-graphite">{label}</dt>
            <dd class="whitespace-pre-line">{value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-6 lg:col-span-12 lg:mt-16">
      <h3 class="text-title font-bold">{company.worksHeading}</h3>
      {company.worksNote && <p class="mt-2 text-[0.875rem] text-graphite">{company.worksNote}</p>}
      <ul class="mt-6 grid border-t border-rule sm:grid-cols-2 sm:gap-x-12 lg:grid-cols-3">
        {
          site.works.map((w) => (
            <li class="border-b border-rule py-5">
              <p class="font-semibold" lang="ko">
                {w.title}
              </p>
              <p class="mt-1 text-[0.875rem] text-graphite">{w.platforms.map((p) => p[lang]).join(', ')}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
