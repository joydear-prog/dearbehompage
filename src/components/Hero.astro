---
import { getLang, t } from '../i18n';

const { hero } = t(getLang(Astro.url));
const [line1, line2] = hero.lines;
---

<!--
  히어로 = 컴패니언이 방문자에게 보내는 첫 메시지.
  인사말과 본문이 동시에 한 글자씩 타이핑됩니다. (페이지의 유일한 '연출' 모먼트)
-->
<section data-hero class="relative flex min-h-[100svh] flex-col overflow-hidden bg-ink text-white">
  <div class="wrap flex flex-1 flex-col justify-center pt-28 pb-12">
    <p class="mb-3 text-[clamp(1.25rem,2.6vw,2.25rem)] font-medium tracking-[-0.02em] text-white/75 md:mb-5">
      <span class="sr-only">{hero.salutation}</span>
      <span aria-hidden="true" data-type>{hero.salutation}</span>
    </p>
    <h1 class="text-display font-bold">
      <span class="sr-only">{hero.lines.join(' ')}</span>
      <span aria-hidden="true" data-type>{line1}<br />{line2}</span>
    </h1>
  </div>

  <div class="wrap pb-8 md:pb-12" data-after-type>
    <div class="flex flex-col gap-5 pt-6 md:flex-row md:items-end md:justify-between">
      <p class="max-w-[30rem] text-[1.0625rem] leading-[1.65] text-white/80 md:text-lg">{hero.lead}</p>
      <p class="inline-flex items-center gap-2.5 text-[0.9375rem] text-white/80">
        <span class="size-2 rounded-full bg-blush" aria-hidden="true"></span>
        {hero.status}
      </p>
    </div>
  </div>
</section>

<script>
  import { prefersReducedMotion } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const targets = hero ? [...hero.querySelectorAll<HTMLElement>('[data-type]')] : [];

  // 줄(target)마다 글자 단위로 쪼개기 (<br>은 유지)
  const lines = targets.map((target) => {
    const chars: HTMLElement[] = [];
    for (const node of [...target.childNodes]) {
      if (node.nodeType !== Node.TEXT_NODE) continue;
      const frag = document.createDocumentFragment();
      for (const ch of Array.from(node.textContent ?? '')) {
        const span = document.createElement('span');
        span.className = 'ch';
        span.textContent = ch;
        frag.append(span);
        chars.push(span);
      }
      node.replaceWith(frag);
    }
    target.setAttribute('data-type-ready', '');
    return { target, chars };
  });

  const finish = () => hero?.classList.add('is-typed');

  if (!hero || prefersReducedMotion) {
    lines.forEach(({ chars }) => chars.forEach((c) => c.classList.add('on')));
    finish();
  } else {
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    // 인사말과 본문이 동시에 써지고, 각 줄에 커서가 따라갑니다.
    // 마지막 줄(본문)의 커서만 끝까지 남아 깜빡입니다.
    const typeLine = async ({ target, chars }: (typeof lines)[number], isLast: boolean) => {
      const caret = document.createElement('span');
      caret.className = 'caret-anchor';
      caret.innerHTML = '<span class="caret"></span>';
      target.prepend(caret);

      for (const ch of chars) {
        // 문장부호·줄바꿈 앞에서는 손을 멈추듯 잠깐 쉼
        const pause = (/[,.?]/.test(ch.textContent ?? '') ? 420 : 0) + (ch.nextSibling?.nodeName === 'BR' ? 300 : 0);
        ch.classList.add('on');
        ch.after(caret);
        await wait(62 + Math.random() * 70 + pause);
      }
      if (!isLast) caret.remove();
    };

    (async () => {
      await wait(650);
      await Promise.all(lines.map((line, i) => typeLine(line, i === lines.length - 1)));
      finish();
    })();
  }
</script>
