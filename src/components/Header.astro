---
import { site } from '../config/site';
import { href } from '../config/url';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const section = (hash: string) => (isHome ? hash : href(hash));
const current = (to: string) => (Astro.url.pathname.replace(/\/$/, '') === to ? 'page' : undefined);

const nav = [
  { label: '서비스', to: section('#service') },
  { label: '안전 원칙', to: section('#safety') },
  { label: '회사', to: section('#company') },
  { label: '고객지원', to: href('support') },
];
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header data-tone={isHome ? 'light' : 'solid'}>
  <div class="wrap flex h-16 items-center justify-between">
    <a href={href()} class="text-[1.375rem] leading-none font-extrabold tracking-[-0.055em]">
      <span class="sr-only">{site.brandKo} 홈</span>
      <span aria-hidden="true">{site.brand}<span class="brand-dot">.</span></span>
    </a>

    <nav aria-label="주요 메뉴" class="hidden md:block">
      <ul class="flex items-center gap-8 text-[0.9375rem] font-medium">
        {
          nav.map((item) => (
            <li>
              <a href={item.to} aria-current={current(item.to)} class="transition-opacity duration-300 hover:opacity-60 aria-[current=page]:underline aria-[current=page]:underline-offset-8">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={section('#contact')}
            class="inline-flex h-10 items-center rounded-full border border-current px-5 transition-colors duration-300 hover:bg-current/10"
          >
            문의하기
          </a>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      class="-mr-2 h-11 px-2 text-[0.9375rem] font-semibold md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      메뉴
    </button>
  </div>

  <nav id="mobile-menu" aria-label="모바일 메뉴" class="fixed inset-x-0 top-16 bottom-0 bg-ink-deep text-white md:hidden" hidden>
    <ul class="wrap flex flex-col pt-6">
      {
        [...nav, { label: '문의하기', to: section('#contact') }].map((item) => (
          <li class="border-b border-white/15">
            <a href={item.to} aria-current={current(item.to)} class="block py-5 text-[1.75rem] font-bold tracking-[-0.03em]">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .brand-dot {
    color: var(--color-blush);
    transition: color 0.4s var(--ease-out-quint);
  }
  [data-tone='solid'] .brand-dot {
    color: var(--color-ink);
  }
  /* 메뉴가 열리면 헤더 바도 메뉴와 같은 색으로 */
  .site-header:has([data-menu-toggle][aria-expanded='true']) {
    background: var(--color-ink-deep);
    color: #fff;
    box-shadow: none;
    backdrop-filter: none;
  }
</style>
