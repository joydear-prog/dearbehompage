---
import { getLang, t } from '../i18n';

const { services } = t(getLang(Astro.url));
const { demo } = services;
const bubbleClass = (from: string) => (from === 'me' ? 'bubble bubble-me' : 'bubble bubble-ai');
---

<section id="service" class="bg-paper pb-28 md:pb-40">
  <div class="wrap">
    <h2 class="max-w-[14em] text-headline font-bold">{services.heading}</h2>

    <div class="mt-14 grid gap-14 md:mt-20 lg:grid-cols-12 lg:gap-12">
      <!-- 기억 기능을 실제 대화로 보여주는 데모 -->
      <figure class="lg:col-span-5">
        <div class="mx-auto max-w-[26rem] rounded-[2rem] bg-mist p-3 lg:sticky lg:top-24">
          <div class="flex items-center gap-3 px-3 pt-2 pb-4">
            <span class="grid size-10 place-items-center rounded-full bg-blush text-[0.9375rem] font-bold" aria-hidden="true">
              {demo.avatar}
            </span>
            <div class="leading-tight">
              <p class="font-semibold">{demo.name}</p>
              <p class="text-[0.8125rem] text-graphite">{demo.role}</p>
            </div>
          </div>

          <div class="flex flex-col gap-2 rounded-[1.5rem] bg-paper p-4">
            {demo.before.map((m) => <p class={bubbleClass(m.from)}>{m.text}</p>)}
            <p class="my-3 text-center text-[0.8125rem] text-graphite">{demo.time}</p>
            {demo.after.map((m) => <p class={bubbleClass(m.from)}>{m.text}</p>)}
          </div>
        </div>
        <figcaption class="mx-auto mt-4 max-w-[26rem] px-3 text-[0.875rem] text-graphite">{demo.caption}</figcaption>
      </figure>

      <ul class="lg:col-span-6 lg:col-start-7">
        {
          services.items.map((s) => (
            <li class="border-t border-rule py-9 first:border-t-0 first:pt-0 md:py-12">
              <h3 class="text-title font-bold">{s.title}</h3>
              <p class="mt-3 max-w-[34rem] text-graphite">{s.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
