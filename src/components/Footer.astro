---
import { site } from '../config/site';
import { getLang, localize, t } from '../i18n';

const lang = getLang(Astro.url);
const ui = t(lang);
const info = ui.footer.info.filter(([, value]) => value);
---

<footer class="bg-ink-deep text-white/65">
  <div class="wrap py-14 md:py-20">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <a href={localize(lang)} class="text-[1.75rem] leading-none font-extrabold tracking-[-0.055em] text-white">
        <span class="sr-only">{ui.nav.home}</span>
        <span aria-hidden="true">{site.brand}<span class="text-blush">.</span></span>
      </a>
      <nav aria-label={ui.footer.legalLabel}>
        <ul class="flex flex-wrap gap-x-7 gap-y-3 text-[0.9375rem]">
          <li><a href={localize(lang, 'privacy')} class="font-bold text-white hover:underline">{ui.footer.privacy}</a></li>
          <li><a href={localize(lang, 'terms')} class="hover:text-white hover:underline">{ui.footer.terms}</a></li>
          <li><a href={localize(lang, 'support')} class="hover:text-white hover:underline">{ui.footer.support}</a></li>
        </ul>
      </nav>
    </div>

    <dl class="mt-12 flex max-w-[60rem] flex-wrap gap-x-6 gap-y-2 text-[0.8125rem] leading-relaxed">
      {
        info.map(([label, value]) => (
          <div class="flex gap-2">
            <dt class="text-white/55">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    {ui.footer.subline && <p class="mt-2 text-[0.8125rem] text-white/55">{ui.footer.subline}</p>}

    <p class="mt-10 text-[0.8125rem] text-white/55">
      © {new Date().getFullYear()} {site.company.legalNameEn} All rights reserved.
    </p>
  </div>
</footer>
