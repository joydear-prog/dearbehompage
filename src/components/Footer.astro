---
import { site } from '../config/site';
import { href } from '../config/url';

const { company } = site;

const info = [
  ['상호', company.legalNameKo],
  ['대표', company.ceo],
  ['사업자등록번호', company.bizRegNo],
  ['통신판매업 신고', company.mailOrderNo],
  ['주소', company.addressKo],
  ['전화', company.phone],
  ['이메일', company.email],
].filter(([, value]) => value);
---

<footer class="bg-ink-deep text-white/65">
  <div class="wrap py-14 md:py-20">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <a href={href()} class="text-[1.75rem] leading-none font-extrabold tracking-[-0.055em] text-white">
        <span class="sr-only">{site.brandKo} 홈</span>
        <span aria-hidden="true">{site.brand}<span class="text-blush">.</span></span>
      </a>
      <nav aria-label="법적 고지 및 지원">
        <ul class="flex flex-wrap gap-x-7 gap-y-3 text-[0.9375rem]">
          <li><a href={href('privacy')} class="font-bold text-white hover:underline">개인정보 처리방침</a></li>
          <li><a href={href('terms')} class="hover:text-white hover:underline">이용약관</a></li>
          <li><a href={href('support')} class="hover:text-white hover:underline">고객지원</a></li>
        </ul>
      </nav>
    </div>

    <dl class="mt-12 flex max-w-[60rem] flex-wrap gap-x-6 gap-y-2 text-[0.8125rem] leading-relaxed">
      {
        info.map(([label, value]) => (
          <div class="flex gap-2">
            <dt class="text-white/55">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-2 text-[0.8125rem] text-white/55">{company.addressEn}</p>

    <p class="mt-10 text-[0.8125rem] text-white/55">
      © {new Date().getFullYear()} {company.legalNameEn} All rights reserved.
    </p>
  </div>
</footer>
