---
import { site } from '../config/site';
import { getLang, localize, t } from '../i18n';

const lang = getLang(Astro.url);
const { contact } = t(lang);
---

<section id="contact" class="bg-ink py-28 text-white md:py-40">
  <div class="wrap">
    <h2 class="text-headline font-bold">{contact.heading}</h2>
    <a
      href={`mailto:${site.company.email}`}
      class="mt-8 inline-block text-[clamp(1.375rem,6vw,5.5rem)] leading-[1.1] font-bold tracking-[-0.04em] underline decoration-white/35 decoration-2 underline-offset-[0.18em] transition-colors duration-300 hover:decoration-white md:mt-12"
    >
      {site.company.email}
    </a>
    <div class="mt-12 flex flex-col gap-3 text-white/75 md:mt-16 md:flex-row md:gap-12">
      <p class="max-w-[30rem]">{contact.body}</p>
      <p>
        {contact.supportBefore}<a href={localize(lang, 'support')} class="font-semibold text-white underline underline-offset-4"
          >{contact.supportLink}</a
        >{contact.supportAfter}
      </p>
    </div>
  </div>
</section>
