---
/*
 * ⚠️ 여기 적힌 약속(문구는 src/i18n/ui.ts)은 앱의 실제 동작과 일치해야 합니다.
 *    (App Store 심사 가이드라인 1.2 사용자 생성 콘텐츠, 5.1.1(v) 계정 삭제, 연령 등급과 직결)
 */
import { getLang, t } from '../i18n';

const { safety } = t(getLang(Astro.url));
---

<section id="safety" class="bg-ink-deep py-28 text-white md:py-40">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <h2 class="max-w-[10em] text-headline font-bold">{safety.heading}</h2>
      <p class="mt-6 max-w-[28rem] text-white/70">{safety.intro}</p>
    </div>

    <ul class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
      {
        safety.principles.map((p) => (
          <li class="border-t border-white/20 pt-6">
            <h3 class="text-[1.25rem] font-bold tracking-[-0.02em]">{p.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-[1.7] text-white/70">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
