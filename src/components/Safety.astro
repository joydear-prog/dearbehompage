---
import { site } from '../config/site';

/*
 * ⚠️ 여기 적힌 약속은 앱의 실제 동작과 일치해야 합니다.
 *    (App Store 심사 가이드라인 1.2 사용자 생성 콘텐츠, 5.1.1(v) 계정 삭제, 연령 등급과 직결)
 */
const principles = [
  {
    title: '대화는 나의 것',
    body: '대화 기록은 암호화해 보관하며, 앱 설정에서 언제든 대화와 계정을 직접 삭제할 수 있습니다.',
  },
  {
    title: '연령에 맞는 경험',
    body: '만 14세 미만은 가입할 수 없습니다. 연령 등급에 맞지 않는 대화는 자동으로 걸러냅니다.',
  },
  {
    title: '힘든 순간에는 사람에게',
    body: '위기 신호가 감지되면 대화를 멈추고 자살예방상담전화(109) 같은 전문 기관을 먼저 안내합니다.',
  },
  {
    title: 'AI임을 분명하게',
    body: `${site.brandKo}의 캐릭터는 모두 AI입니다. 앱 안에서 항상 이를 표시하고, 사람인 척하지 않습니다.`,
  },
];
---

<section id="safety" class="bg-ink-deep py-28 text-white md:py-40">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <h2 class="max-w-[10em] text-headline font-bold">안심하고 털어놓을 수 있도록</h2>
      <p class="mt-6 max-w-[28rem] text-white/70">
        마음을 나누는 대화일수록 더 엄격한 기준이 필요합니다. {site.brandKo}는 서비스의 모든 단계에 다음 원칙을 적용합니다.
      </p>
    </div>

    <ul class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
      {
        principles.map((p) => (
          <li class="border-t border-white/20 pt-6">
            <h3 class="text-[1.25rem] font-bold tracking-[-0.02em]">{p.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-[1.7] text-white/70">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
