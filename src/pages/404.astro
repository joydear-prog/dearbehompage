---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../config/url';
---

<BaseLayout title="페이지를 찾을 수 없어요">
  <section class="wrap flex min-h-[80svh] flex-col justify-center pt-32 pb-24">
    <h1 class="text-headline font-bold">찾으시는 페이지가 없어요</h1>
    <p class="mt-5 max-w-[30rem] text-graphite">주소가 바뀌었거나 삭제된 페이지입니다. 홈에서 다시 시작해 주세요.</p>
    <a href={href()} class="mt-10 inline-flex h-12 w-fit items-center rounded-full bg-ink px-6 font-semibold text-white">홈으로 가기</a>
  </section>
</BaseLayout>
