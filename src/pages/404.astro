---
// GitHub Pages는 루트의 404.html 하나만 쓰므로 한국어·영어를 함께 보여줍니다.
import BaseLayout from '../layouts/BaseLayout.astro';
import { localize, t } from '../i18n';

const ko = t('ko').notFound;
const en = t('en').notFound;
---

<BaseLayout title={ko.title}>
  <section class="wrap flex min-h-[80svh] flex-col justify-center pt-32 pb-24">
    <h1 class="text-headline font-bold">{ko.heading}</h1>
    <p class="mt-5 max-w-[30rem] text-graphite">{ko.body}</p>
    <p class="mt-2 max-w-[30rem] text-graphite" lang="en">{en.heading}. {en.body}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={localize('ko')} class="inline-flex h-12 items-center rounded-full bg-ink px-6 font-semibold text-white">{ko.cta}</a>
      <a href={localize('en')} lang="en" class="inline-flex h-12 items-center rounded-full border border-ink px-6 font-semibold text-ink">
        {en.cta}
      </a>
    </div>
  </section>
</BaseLayout>
