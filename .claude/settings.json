{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run check)",
      "Bash(npm run shot)",
      "Bash(npm run shot -- *)",
      "Bash(python3 .claude/skills/ui-ux-pro-max/scripts/search.py *)"
    ]
  },
  "env": {
    "ASTRO_TELEMETRY_DISABLED": "1",
    "DO_NOT_TRACK": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh"
          }
        ]
      }
    ]
  }
}
